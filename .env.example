# Online Cosmetic Store Website - Environment Configuration
# 12-Factor Environment Parity Specification (ARCH-7237)

# Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database Connection (Cloud SQL PostgreSQL or local SQLite fallback)
DATABASE_URL=postgresql://cosmetics_user:cosmetics_password@localhost:5432/cosmetics_store
SQLITE_DB_PATH=store.db
DATABASE_PATH=store.db

# Security & Authentication
JWT_SECRET=atelier-luxury-cosmetic-jwt-secret-key-2026
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Business Rules & Idempotency
IDEMPOTENCY_EXPIRY_SECONDS=86400
INVENTORY_ALERT_THRESHOLD=15
OPENTELEMETRY_ENABLED=true
